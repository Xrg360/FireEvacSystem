# Copy to .env and adjust. docker-compose.yml provides its own values.

# Database: Postgres in Docker, or SQLite for quick local runs.
DATABASE_URL=sqlite:///fire.db
# DATABASE_URL=postgresql+psycopg://fire:fire@localhost:5432/fire

# Redis: leave empty to use in-process memory (single process only).
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# Long random string. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Run the engine loop inside the API process (local dev without Docker).
ENGINE_INPROCESS=1

# Firebase service account JSON path for FCM push. Leave empty to disable push.
FIREBASE_CREDENTIALS=

# Optional MQTT ingest for sensors.
MQTT_HOST=
MQTT_PORT=1883

# Days to keep resident position history.
POSITION_RETENTION_DAYS=7
